<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.TodaysScheduleController">

    <TableView fx:id="scheduleTable">

        <columns>

            <TableColumn fx:id="courseCodeColumn"
                         text="Course Code"/>

            <TableColumn fx:id="courseNameColumn"
                         text="Course Name"/>

            <TableColumn fx:id="roomColumn"
                         text="Room"/>

            <TableColumn fx:id="startTimeColumn"
                         text="Start Time"/>

            <TableColumn fx:id="endTimeColumn"
                         text="End Time"/>

            <TableColumn fx:id="statusColumn"
                         text="Status"/>

        </columns>

    </TableView>
</AnchorPane>