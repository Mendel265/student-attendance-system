<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.chart.PieChart?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../styles/lecture_dashboard.css"
            fx:controller="com.example.studentattendance.LecturerDashboardController"
            styleClass="dashboard">

    <!-- ================= LEFT SIDEBAR ================= -->
    <left>
        <VBox prefWidth="240" styleClass="sidebar">

            <!-- Logo / Brand -->
            <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="10">
                <Label text="🎓" styleClass="logo-icon"/>
                <Label text="Smart Attendance" styleClass="logo"/>
            </HBox>

            <!-- Nav links -->
            <VBox styleClass="nav-group" spacing="4">
                <Button text="🏠  Dashboard" styleClass="nav-button, nav-button-active" maxWidth="Infinity"/>
                <Button text="👥  Students" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="📷  Attendance" onAction="#handleTakeAttendance" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="🧠  Train Model" onAction="#handleTrainModel" styleClass="nav-button" maxWidth="Infinity"/>
                <Button text="📊  Reports" onAction="#onPrintAttendance" styleClass="nav-button" maxWidth="Infinity"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Footer / Logout -->
            <VBox styleClass="sidebar-footer">
                <Button text="⎋  Logout" onAction="#handleLogout" styleClass="logout-button" maxWidth="Infinity"/>
            </VBox>

        </VBox>
    </left>

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="topbar">
            <padding>
                <Insets top="16" right="32" bottom="16" left="32"/>
            </padding>

            <VBox spacing="2">
                <Label text="Lecturer Dashboard" styleClass="page-title"/>
                <Label text="Overview of your classes and attendance activity" styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <StackPane styleClass="profile-avatar">
                <Circle radius="18"/>
                <Label text="MB" styleClass="profile-initials"/>
            </StackPane>
        </HBox>
    </top>

    <!-- ================= CENTER CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox spacing="28" styleClass="content-area">
                <padding>
                    <Insets top="32" right="40" bottom="40" left="40"/>
                </padding>

                <Label text="Welcome back, Lecturer 👋" styleClass="welcome"/>

                <!-- ===== STAT CARDS ===== -->
                <!-- ===== STAT CARDS ===== -->
                <HBox spacing="20">

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">

                        <Label text="👥" styleClass="stat-icon"/>

                        <Label fx:id="totalStudentsLabel"
                               text="0"
                               styleClass="stat-number"/>

                        <Label text="Total Students"
                               styleClass="stat-label"/>

                    </VBox>


                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">

                        <Label text="✅" styleClass="stat-icon"/>

                        <Label fx:id="attendancePercentageLabel"
                               text="0%"
                               styleClass="stat-number"/>

                        <Label text="Today's Attendance"
                               styleClass="stat-label"/>

                    </VBox>


                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">

                        <Label text="📚" styleClass="stat-icon"/>

                        <Label fx:id="assignedClassesLabel"
                               text="0"
                               styleClass="stat-number"/>

                        <Label text="Assigned Classes"
                               styleClass="stat-label"/>

                    </VBox>

                </HBox>

                <VBox spacing="10">

                    <Label text="Today's Schedule"
                           styleClass="section-title"/>

                    <TableView fx:id="scheduleTable"
                               prefHeight="220">

                        <columns>

                            <TableColumn text="Time"
                                         fx:id="scheduleTimeColumn"/>

                            <TableColumn text="Module"
                                         fx:id="scheduleModuleColumn"/>

                            <TableColumn text="Class"
                                         fx:id="scheduleClassColumn"/>

                            <TableColumn text="Status"
                                         fx:id="scheduleStatusColumn"/>

                        </columns>

                    </TableView>

                </VBox>

                <!-- ===== QUICK ACTIONS ===== -->
                <VBox spacing="14">
                    <Label text="Quick Actions" styleClass="section-title"/>

                    <HBox spacing="20">

                        <Button text="📷&#10;Take Attendance"
                                styleClass="action-card"
                                onAction="#handleTakeAttendance"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"/>

                        <Button text="👤&#10;Register Student"
                                styleClass="action-card"
                                onAction="#handleRegisterStudent"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"/>

                        <Button text="🧠&#10;Train Model"
                                styleClass="action-card"
                                onAction="#handleTrainModel"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"/>

                        <Button text="📊&#10;Reports"
                                styleClass="action-card"
                                onAction="#onPrintAttendance"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"/>

                    </HBox>

                    <HBox spacing="20">

                        <VBox styleClass="dashboard-card"
                              HBox.hgrow="ALWAYS">

                            <Label text="Attendance Overview"
                                   styleClass="section-title"/>

                            <PieChart fx:id="attendanceChart"/>

                        </VBox>

                        <VBox styleClass="dashboard-card"
                              HBox.hgrow="ALWAYS">

                            <Label text="Recent Activity"
                                   styleClass="section-title"/>

                            <ListView fx:id="activityList"/>

                        </VBox>

                    </HBox>
                    <VBox spacing="10">

                        <Label text="Recent Attendance"
                               styleClass="section-title"/>

                        <TableView fx:id="attendanceTable">

                            <columns>

                                <TableColumn fx:id="fnameColumn" text="First Name"/>

                                <TableColumn fx:id="lastnameColumn" text="Last Name"/>

                                <TableColumn fx:id="moduleColumn" text="Module"/>

                                <TableColumn fx:id="classColumn" text="Class"/>

                                <TableColumn fx:id="statusColumn" text="Status"/>

                                <TableColumn fx:id="timeColumn" text="Time"/>

                            </columns>

                        </TableView>

                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
