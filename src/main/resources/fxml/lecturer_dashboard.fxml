<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.chart.PieChart?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../styles/lecture_dashboard.css"
            fx:controller="com.example.studentattendance.LecturerDashboardController"
            styleClass="dashboard">

    <!-- ================= LEFT SIDEBAR ================= -->
    <left>
        <VBox prefWidth="240" styleClass="sidebar">

            <!-- Logo / Brand -->
            <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="10">
                <FontIcon iconLiteral="fas-graduation-cap" styleClass="logo-icon"/>
                <Label text="Smart Attendance" styleClass="logo"/>
            </HBox>

            <!-- Nav links -->
            <VBox styleClass="nav-group" spacing="4">
                <Button styleClass="nav-button, nav-button-active" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-home" styleClass="nav-icon"/>
                    </graphic>
                    <text>Dashboard</text>
                </Button>

                <Button styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-users" styleClass="nav-icon"/>
                    </graphic>
                    <text>Students</text>
                </Button>

                <Button onAction="#handleTakeAttendance" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-camera" styleClass="nav-icon"/>
                    </graphic>
                    <text>Attendance</text>
                </Button>

                <Button onAction="#handleTrainModel" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-brain" styleClass="nav-icon"/>
                    </graphic>
                    <text>Train Model</text>
                </Button>

                <Button onAction="#onPrintAttendance" styleClass="nav-button" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-chart-bar" styleClass="nav-icon"/>
                    </graphic>
                    <text>Reports</text>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Footer / Logout -->
            <VBox styleClass="sidebar-footer">
                <Button onAction="#handleLogout" styleClass="logout-button" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-sign-out-alt" styleClass="logout-icon"/>
                    </graphic>
                    <text>Logout</text>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="topbar">
            <padding>
                <Insets top="16" right="32" bottom="16" left="32"/>
            </padding>

            <VBox spacing="2">
                <Label text="Lecturer Dashboard" styleClass="page-title"/>
                <Label text="Overview of your classes and attendance activity" styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <StackPane styleClass="profile-avatar">
                <Circle radius="18" styleClass="profile-circle"/>
                <Label text="MB" styleClass="profile-initials"/>
            </StackPane>
        </HBox>
    </top>

    <!-- ================= CENTER CONTENT ================= -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox spacing="28" styleClass="content-area">
                <padding>
                    <Insets top="32" right="40" bottom="40" left="40"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <FontIcon styleClass="welcome-icon"/>
                    <Label text="Welcome back, Lecturer" styleClass="welcome"/>
                </HBox>

                <!-- ===== STAT CARDS ===== -->
                <HBox spacing="20">

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-user-graduate" styleClass="stat-icon"/>
                        <Label fx:id="totalStudentsLabel" text="0" styleClass="stat-number"/>
                        <Label text="Total Students" styleClass="stat-label"/>
                    </VBox>

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-check-circle" styleClass="stat-icon"/>
                        <Label fx:id="attendancePercentageLabel" text="0%" styleClass="stat-number"/>
                        <Label text="Today's Attendance" styleClass="stat-label"/>
                    </VBox>

                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <FontIcon iconLiteral="fas-book" styleClass="stat-icon"/>
                        <Label fx:id="assignedClassesLabel" text="0" styleClass="stat-number"/>
                        <Label text="Assigned Classes" styleClass="stat-label"/>
                    </VBox>

                </HBox>

                <!-- ===== TODAY'S SCHEDULE ===== -->
                <VBox spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fas-clock" styleClass="section-icon"/>
                        <Label text="Today's Schedule" styleClass="section-title"/>
                    </HBox>

                    <TableView fx:id="scheduleTable" prefHeight="220">
                        <columns>
                            <TableColumn text="Time" fx:id="scheduleTimeColumn"/>
                            <TableColumn text="Module" fx:id="scheduleModuleColumn"/>
                            <TableColumn text="Class" fx:id="scheduleClassColumn"/>
                            <TableColumn text="Status" fx:id="scheduleStatusColumn"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- ===== QUICK ACTIONS ===== -->
                <VBox spacing="14">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fas-bolt" styleClass="section-icon"/>
                        <Label text="Quick Actions" styleClass="section-title"/>
                    </HBox>

                    <HBox spacing="20">
                        <Button onAction="#handleTakeAttendance" styleClass="action-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <graphic>
                                <FontIcon iconLiteral="fas-camera" styleClass="action-icon-large"/>
                            </graphic>
                            <text>Take Attendance</text>
                        </Button>

                        <Button onAction="#handleRegisterStudent" styleClass="action-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <graphic>
                                <FontIcon iconLiteral="fas-user-plus" styleClass="action-icon-large"/>
                            </graphic>
                            <text>Register Student</text>
                        </Button>

                        <Button onAction="#handleTrainModel" styleClass="action-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <graphic>
                                <FontIcon iconLiteral="fas-brain" styleClass="action-icon-large"/>
                            </graphic>
                            <text>Train Model</text>
                        </Button>

                        <Button onAction="#onPrintAttendance" styleClass="action-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <graphic>
                                <FontIcon iconLiteral="fas-file-alt" styleClass="action-icon-large"/>
                            </graphic>
                            <text>Reports</text>
                        </Button>
                    </HBox>

                    <!-- ===== ATTENDANCE OVERVIEW & RECENT ACTIVITY ===== -->
                    <HBox spacing="20">
                        <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <FontIcon iconLiteral="fas-chart-pie" styleClass="section-icon"/>
                                <Label text="Attendance Overview" styleClass="section-title"/>
                            </HBox>
                            <PieChart fx:id="attendanceChart"/>
                        </VBox>

                        <VBox styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <FontIcon iconLiteral="fas-history" styleClass="section-icon"/>
                                <Label text="Recent Activity" styleClass="section-title"/>
                            </HBox>
                            <ListView fx:id="activityList"/>
                        </VBox>
                    </HBox>

                    <!-- ===== RECENT ATTENDANCE ===== -->
                    <VBox spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <FontIcon iconLiteral="fas-table" styleClass="section-icon"/>
                            <Label text="Recent Attendance" styleClass="section-title"/>
                        </HBox>

                        <TableView fx:id="attendanceTable">
                            <columns>
                                <TableColumn fx:id="fnameColumn" text="First Name"/>
                                <TableColumn fx:id="lastnameColumn" text="Last Name"/>
                                <TableColumn fx:id="moduleColumn" text="Module"/>
                                <TableColumn fx:id="classColumn" text="Class"/>
                                <TableColumn fx:id="statusColumn" text="Status"/>
                                <TableColumn fx:id="timeColumn" text="Time"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>