<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- SemesterSelection.fxml -->
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.studentattendance.SemesterSelectionController">
    <VBox alignment="CENTER" spacing="20" prefWidth="400" prefHeight="300">
        <Label fx:id="classLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <Button text="First Semester" onAction="#handleFirstSemester" prefWidth="200"/>
        <Button text="Second Semester" onAction="#handleSecondSemester" prefWidth="200"/>
    </VBox>
</AnchorPane>

