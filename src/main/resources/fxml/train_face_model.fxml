<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox spacing="0" alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.studentattendance.TrainFaceModelController"
      stylesheets="@../styles/train_model.css"
      styleClass="train-root">

    <VBox spacing="20" alignment="CENTER" styleClass="train-card" maxWidth="420">
        <padding>
            <Insets top="36" right="36" bottom="36" left="36"/>
        </padding>

        <!-- Icon -->
        <StackPane styleClass="icon-badge">
            <Circle radius="34"/>
            <Label text="🧠" styleClass="icon-label"/>
        </StackPane>

        <!-- Title -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="Train Face Recognition Model" styleClass="page-title" wrapText="true" textAlignment="CENTER"/>
            <Label text="Rebuilds the recognizer using all registered student faces"
                   styleClass="page-subtitle" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <!-- Train Button -->
        <Button fx:id="trainButton" text="⚙  Train Model" onAction="#trainModel"
                maxWidth="Infinity" styleClass="btn-train"/>

        <!-- Status -->
        <StackPane styleClass="status-pill">
            <Label fx:id="statusLabel" text="Status: Waiting to start..." styleClass="status-label"/>
        </StackPane>

    </VBox>

</VBox>
