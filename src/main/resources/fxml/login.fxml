<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.StackPane?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../styles/login.css"
            fx:controller="com.example.studentattendance.LoginController">

<children>

    <StackPane AnchorPane.topAnchor="0"
               AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0">

        <VBox fx:id="loginCard"
              alignment="CENTER"
              prefWidth="400"
              maxWidth="480"
              spacing="18"
              styleClass="login-card">

            <Label text="Student Attendance System"
                   styleClass="login-title"/>

            <Label text="Secure Face Recognition Platform"
                   styleClass="login-subtitle"/>

            <TextField fx:id="usernameField"
                       promptText="Username"
                       styleClass="input-field"/>

            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           styleClass="input-field"/>

            <Button text="SIGN IN"
                    onAction="#handleLogin"
                    styleClass="primary-button"/>

            <Hyperlink text="Don't have an account? Sign Up"
                       onAction="#goToSignup"
                       styleClass="signup-link"/>

        </VBox>

    </StackPane>

</children>

</AnchorPane>
