<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.studentattendance.PrintAttendanceDialogController"
      spacing="20">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label text="Generate Attendance Report" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="15">
        <Label text="Semester:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="semesterComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Class:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="classComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Module:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="moduleComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"/>
    </GridPane>

    <HBox alignment="CENTER_RIGHT">


        <Button fx:id="printAttendanceButton" text="Generate Report" onAction="#onGenerateReport"/>
    </HBox>

</VBox>
