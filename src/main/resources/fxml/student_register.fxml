<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.studentattendance.StudentRegisterController"
      spacing="20"
      alignment="TOP_CENTER"
      style="-fx-background-color: #f4f6f9; -fx-padding: 30;">

    <!-- Title -->
    <Label text="Register Student"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <!-- Form Fields -->
    <GridPane hgap="15" vgap="15">
        <padding>
            <Insets top="10" right="20" bottom="10" left="20"/>
        </padding>

        <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="fnameField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                   style="-fx-pref-width: 250px;"/>

        <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="lnameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Class:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="classField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Student ID:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="studentIdField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Camera Preview -->
    <ImageView fx:id="cameraView"
               fitWidth="320" fitHeight="240" preserveRatio="true"
               style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 2);"/>

    <!-- Buttons -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="captureButton"
                text="Capture Face"
                onAction="#handleCaptureFace"
                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 150px;"/>

        <Button fx:id="registerButton"
                text="Register Student"
                onAction="#handleRegisterStudent"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 150px;"/>
    </HBox>

</VBox>
