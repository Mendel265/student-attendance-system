<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.StudentRegisterController"
            fitToWidth="true"
            stylesheets="@../styles/student_register.css"
            styleClass="register-scroll">

    <VBox spacing="24" alignment="TOP_CENTER" styleClass="register-root">
        <padding>
            <Insets top="36" right="40" bottom="40" left="40"/>
        </padding>

        <!-- Header -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="Register Student" styleClass="page-title"/>
            <Label text="Add a new student and capture their face for recognition" styleClass="page-subtitle"/>
        </VBox>

        <HBox spacing="28" alignment="TOP_CENTER" styleClass="register-layout">

            <!-- ===== Form Card ===== -->
            <VBox spacing="18" styleClass="form-card">
                <Label text="Student Details" styleClass="card-heading"/>

                <GridPane hgap="16" vgap="16" styleClass="form-grid">
                    <columnConstraints>
                        <ColumnConstraints minWidth="110"/>
                        <ColumnConstraints minWidth="220" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="First Name" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="fnameField" promptText="e.g. Mendel" styleClass="text-input"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Last Name" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="lnameField" promptText="e.g. Banda" styleClass="text-input"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Email" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="emailField" promptText="student@dyuni.ac.mw" styleClass="text-input"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Class" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="classField" promptText="e.g. BSc IT 3A" styleClass="text-input"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Student ID" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="studentIdField" promptText="e.g. BIT2023001" styleClass="text-input"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <Button fx:id="registerButton" text="✔  Register Student" onAction="#handleRegisterStudent"
                        maxWidth="Infinity" styleClass="btn-register"/>
            </VBox>

            <!-- ===== Camera Card ===== -->
            <VBox spacing="16" alignment="CENTER" styleClass="camera-card">
                <Label text="Face Capture" styleClass="card-heading"/>

                <StackPane styleClass="camera-frame">
                    <ImageView fx:id="cameraView" fitWidth="300" fitHeight="240" preserveRatio="true"
                               styleClass="camera-view"/>
                </StackPane>

                <Label text="Position the student's face in view, then capture" styleClass="camera-hint"/>

                <Button fx:id="captureButton" text="📷  Capture Face" onAction="#handleCaptureFace"
                        maxWidth="Infinity" styleClass="btn-capture"/>
            </VBox>

        </HBox>

    </VBox>
</ScrollPane>
