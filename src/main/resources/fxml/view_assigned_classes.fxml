<?xml version="1.0" encoding="UTF-8"?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.ViewAssignedClassesController"
            prefWidth="680" prefHeight="560"
            stylesheets="@../styles/view_assigned_classes.css"
            styleClass="assigned-root">

    <center>
        <VBox spacing="18" alignment="TOP_CENTER">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <!-- Header -->
            <VBox alignment="CENTER" spacing="6">
                <Label text="Assigned Classes and Modules" styleClass="page-title"/>
                <Label fx:id="lecturerLabel" text="Lecturer: " styleClass="lecturer-pill"/>
            </VBox>

            <!-- List Card -->
            <VBox spacing="0" styleClass="list-card" VBox.vgrow="ALWAYS">
                <ListView fx:id="assignedListView" VBox.vgrow="ALWAYS" styleClass="assigned-list"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>