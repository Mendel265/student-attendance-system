<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.studentattendance.AddLecturerController"
      spacing="18"
      alignment="TOP_CENTER"
      styleClass="form-container">

    <padding>
        <Insets top="30"
                right="35"
                bottom="30"
                left="35"/>
    </padding>


    <!-- Header -->
    <VBox spacing="5"
          alignment="CENTER">

        <HBox spacing="10"
              alignment="CENTER">

            <FontIcon iconLiteral="fas-chalkboard-teacher"
                      styleClass="header-icon"/>

            <Label text="Register Lecturer"
                   styleClass="page-title"/>

        </HBox>

        <Label text="Create a lecturer profile and login credentials"
               styleClass="page-subtitle"/>

    </VBox>


    <!-- Form -->
    <VBox spacing="14"
          maxWidth="420">

        <!-- First Name -->
        <VBox spacing="5">

            <Label text="First Name"
                   styleClass="field-caption"/>

            <TextField fx:id="firstNameField"
                       promptText="Enter first name"
                       styleClass="text-input"/>

        </VBox>


        <!-- Last Name -->
        <VBox spacing="5">

            <Label text="Last Name"
                   styleClass="field-caption"/>

            <TextField fx:id="lastNameField"
                       promptText="Enter last name"
                       styleClass="text-input"/>

        </VBox>


        <!-- Email -->
        <VBox spacing="5">

            <Label text="Email"
                   styleClass="field-caption"/>

            <TextField fx:id="emailField"
                       promptText="lecturer@example.com"
                       styleClass="text-input"/>

        </VBox>


        <!-- Department -->
        <VBox spacing="5">

            <Label text="Department"
                   styleClass="field-caption"/>

            <TextField fx:id="departmentField"
                       promptText="e.g. ICT"
                       styleClass="text-input"/>

        </VBox>


        <!-- Divider / Login section -->
        <Label text="Login Credentials"
               styleClass="section-title"/>


        <!-- Username -->
        <VBox spacing="5">

            <Label text="Username"
                   styleClass="field-caption"/>

            <TextField fx:id="usernameField"
                       promptText="Create username"
                       styleClass="text-input"/>

        </VBox>


        <!-- Password -->
        <VBox spacing="5">

            <Label text="Temporary Password"
                   styleClass="field-caption"/>

            <PasswordField fx:id="passwordField"
                           promptText="Create temporary password"
                           styleClass="text-input"/>

        </VBox>


        <!-- Buttons -->
        <HBox spacing="12"
              alignment="CENTER_RIGHT"
              styleClass="form-actions">

            <Button text="Cancel"
                    onAction="#handleCancel"
                    styleClass="btn-secondary"/>

            <Button text="Register Lecturer"
                    onAction="#handleRegister"
                    styleClass="btn-primary"/>

        </HBox>

    </VBox>

</VBox>
