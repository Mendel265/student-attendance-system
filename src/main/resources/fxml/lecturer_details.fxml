<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.studentattendance.LecturerDetailsController"
      spacing="0" alignment="TOP_CENTER"
      stylesheets="@../styles/lecturer_details.css"
      styleClass="details-root">

    <padding>
        <Insets top="40" right="36" bottom="40" left="36"/>
    </padding>

    <VBox spacing="24" alignment="CENTER" styleClass="details-card" maxWidth="380">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <!-- Lecturer Identity -->
        <StackPane styleClass="avatar-badge">
            <Circle radius="30"/>
            <Label text="👤" styleClass="avatar-icon"/>
        </StackPane>

        <VBox alignment="CENTER" spacing="2">
            <Label text="Lecturer" styleClass="eyebrow"/>
            <Label fx:id="lecturerLabel" text="Lecturer: " styleClass="lecturer-name" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <!-- Actions -->
        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <Button text="📋  View Assigned Classes &amp; Modules"
                    onAction="#handleViewAssignedClasses"
                    maxWidth="Infinity"
                    styleClass="btn-primary"/>

        </VBox>

    </VBox>

</VBox>
