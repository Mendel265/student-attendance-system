<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.studentattendance.ViewModulesController"
      spacing="18" alignment="TOP_CENTER"
      stylesheets="@../styles/view_modules.css"
      styleClass="modules-root">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Header -->
    <VBox alignment="CENTER" spacing="6">
        <Label text="Modules" styleClass="page-title"/>
        <Label fx:id="classLabel" styleClass="class-pill"/>
    </VBox>

    <!-- List Card -->
    <VBox spacing="0" styleClass="list-card" VBox.vgrow="ALWAYS">
        <ListView fx:id="modulesListView" VBox.vgrow="ALWAYS" styleClass="modules-list"/>
    </VBox>

    <Button text="🔍  View Modules" onAction="#handleViewModules" maxWidth="Infinity" styleClass="btn-primary"/>

</VBox>
