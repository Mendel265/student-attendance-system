<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.studentattendance.ViewModulesController"
      spacing="10" alignment="TOP_CENTER">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label fx:id="classLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <ListView fx:id="modulesListView" prefHeight="400"/>
    <Button text="View Modules" onAction="#handleViewModules" />
</VBox>
