<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.TakeAttendanceController"
            prefWidth="820" prefHeight="680"
            stylesheets="@../styles/take_attendance.css"
            styleClass="attendance-root">

    <children>
        <VBox alignment="TOP_CENTER" spacing="22" styleClass="attendance-container"
              AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

            <padding>
                <Insets top="28" right="32" bottom="28" left="32"/>
            </padding>

            <!-- Header -->
            <VBox alignment="CENTER" spacing="4">
                <Label text="Take Attendance" styleClass="page-title"/>
                <Label text="Select a class, then start check-in or check-out" styleClass="page-subtitle"/>
            </VBox>

            <!-- Class Selection Card -->
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="selector-card">
                <Label text="Select Class:" styleClass="selector-label"/>

                <VBox spacing="2">
                    <Label text="Semester" styleClass="field-caption"/>
                    <ComboBox fx:id="semesterComboBox" promptText="Semester" styleClass="dropdown"/>
                </VBox>

                <VBox spacing="2">
                    <Label text="Module" styleClass="field-caption"/>
                    <ComboBox fx:id="moduleComboBox" promptText="Module" styleClass="dropdown"/>
                </VBox>

                <VBox spacing="2">
                    <Label text="Class" styleClass="field-caption"/>
                    <ComboBox fx:id="classComboBox" promptText="Class" styleClass="dropdown"/>
                </VBox>
            </HBox>

            <!-- Webcam View -->
            <StackPane styleClass="webcam-frame">
                <ImageView fx:id="webcamView" fitWidth="700" fitHeight="440" preserveRatio="true"
                           styleClass="webcam-view"/>
            </StackPane>

            <!-- Status Row -->
            <HBox alignment="CENTER" spacing="10" styleClass="status-pill">
                <Circle radius="5" styleClass="status-dot"/>
                <Label fx:id="statusLabel" text="Status: Idle" styleClass="status-label"/>
            </HBox>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="24">
                <Button fx:id="checkInButton" text="▶  Start Check-In" onAction="#onCheckIn"
                        prefWidth="200" styleClass="btn-checkin"/>
                <Button fx:id="checkOutButton" text="⏹  Start Check-Out" onAction="#onCheckOut"
                        prefWidth="200" styleClass="btn-checkout"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
