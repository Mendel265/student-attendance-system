<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.TakeAttendanceController"
            prefWidth="820" prefHeight="680"
            stylesheets="@../styles/take_attendance.css"
            styleClass="attendance-root">

    <children>

        <VBox alignment="TOP_CENTER"
              spacing="12"
              styleClass="attendance-container"
              AnchorPane.topAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              AnchorPane.bottomAnchor="0">

            <padding>
                <Insets top="16"
                        right="24"
                        bottom="16"
                        left="24"/>
            </padding>


            <!-- HEADER -->
            <VBox alignment="CENTER" spacing="2">

                <Label text="Take Attendance"
                       styleClass="page-title"/>

                <Label text="Select a class, then start check-in or check-out"
                       styleClass="page-subtitle"/>

            </VBox>


            <!-- CLASS SELECTION -->
            <HBox alignment="CENTER"
                  spacing="12"
                  styleClass="selector-card">

                <VBox spacing="2">

                    <Label text="Semester"
                           styleClass="field-caption"/>

                    <ComboBox fx:id="semesterComboBox"
                              promptText="Semester"
                              prefWidth="170"
                              styleClass="dropdown"/>

                </VBox>


                <VBox spacing="2">

                    <Label text="Module"
                           styleClass="field-caption"/>

                    <ComboBox fx:id="moduleComboBox"
                              promptText="Module"
                              prefWidth="220"
                              styleClass="dropdown"/>

                </VBox>


                <VBox spacing="2">

                    <Label text="Class"
                           styleClass="field-caption"/>

                    <ComboBox fx:id="classComboBox"
                              promptText="Class"
                              prefWidth="170"
                              styleClass="dropdown"/>

                </VBox>

            </HBox>


            <!-- WEBCAM -->
            <StackPane alignment="CENTER"
                       prefWidth="540"
                       prefHeight="300"
                       maxWidth="540"
                       maxHeight="300"
                       styleClass="webcam-frame">

                <ImageView fx:id="webcamView"
                           fitWidth="520"
                           fitHeight="280"
                           preserveRatio="true"
                           smooth="true"
                           styleClass="webcam-view"/>

            </StackPane>


            <!-- STATUS -->
            <HBox alignment="CENTER"
                  spacing="8"
                  styleClass="status-pill">

                <Circle radius="5"
                        styleClass="status-dot"/>

                <Label fx:id="statusLabel"
                       text="Status: Idle"
                       styleClass="status-label"/>

            </HBox>


            <!-- BUTTONS -->
            <HBox alignment="CENTER"
                  spacing="16">

                <Button fx:id="checkInButton"
                        text="▶  Start Check-In"
                        onAction="#onCheckIn"
                        prefWidth="190"
                        prefHeight="42"
                        styleClass="btn-checkin"/>

                <Button fx:id="checkOutButton"
                        text="▶  Start Check-Out"
                        onAction="#onCheckOut"
                        prefWidth="190"
                        prefHeight="42"
                        styleClass="btn-checkout"/>

            </HBox>

        </VBox>

    </children>
</AnchorPane>
