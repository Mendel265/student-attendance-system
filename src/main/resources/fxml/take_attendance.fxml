<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.studentattendance.TakeAttendanceController"
            prefWidth="800" prefHeight="620"
            style="-fx-background-color: #f9fbfd;">

    <children>
        <VBox alignment="TOP_CENTER" spacing="20"
              AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">



            <!-- Title -->
            <Label text="Take Attendance"
                   style="-fx-font-size: 26px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;" />

            <!-- Class Selection -->
            <HBox alignment="CENTER" spacing="10">
                <Label text="Select Class:"
                       style="-fx-font-size: 14px; -fx-text-fill: #34495e;" />
                <ComboBox fx:id="semesterComboBox"  />
                <ComboBox fx:id="moduleComboBox"  />
                <ComboBox fx:id="classComboBox"  />



            </HBox>

            <!-- Webcam View -->
            <ImageView fx:id="webcamView" fitWidth="680" fitHeight="480" preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0.2, 0, 3); -fx-border-color: #dfe6e9; -fx-border-radius: 5;" />

            <!-- Status Label -->
            <Label fx:id="statusLabel"
                   text="Status: Idle"
                   style="-fx-font-size: 16px; -fx-text-fill: #2980b9;" />

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="30">
                <Button fx:id="checkInButton" text=" Start Check-In" onAction="#onCheckIn" prefWidth="180"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px;" />
                <Button fx:id="checkOutButton" text=" Start Check-Out" onAction="#onCheckOut" prefWidth="180"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 14px;" />
            </HBox>

        </VBox>
    </children>
</AnchorPane>
