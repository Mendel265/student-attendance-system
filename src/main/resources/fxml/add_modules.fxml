<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import javafx.geometry.Insets?>
<AnchorPane fx:controller="com.example.studentattendance.AddModulesController" xmlns:fx="http://javafx.com/fxml">
    <VBox spacing="10" alignment="TOP_CENTER" >
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <Label fx:id="classLabel" style="-fx-font-size: 18px; -fx-font-weight: bold" />
        <TextField fx:id="moduleNameField" promptText="Enter Module Name" />
        <Button text="Add Module" onAction="#handleAddModule" />
        <!-- Add module management UI later here -->
    </VBox>
</AnchorPane>
