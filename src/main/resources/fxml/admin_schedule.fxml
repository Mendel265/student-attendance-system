<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.studentattendance.ManageScheduleController"
      spacing="15">

    <padding>
        <Insets top="25"
                right="25"
                bottom="25"
                left="25"/>
    </padding>

    <Label text="Manage Lecture Schedule">
        <font>
            <Font size="24"/>
        </font>
    </Label>

    <TableView fx:id="scheduleTable"
               prefHeight="500">

        <columns>

            <TableColumn fx:id="lecturerColumn"
                         text="Lecturer"
                         prefWidth="180"/>

            <TableColumn fx:id="moduleColumn"
                         text="Module"
                         prefWidth="180"/>

            <TableColumn fx:id="classColumn"
                         text="Class"
                         prefWidth="180"/>

            <TableColumn fx:id="dayColumn"
                         text="Day"
                         prefWidth="120"/>

            <TableColumn fx:id="startTimeColumn"
                         text="Start Time"
                         prefWidth="110"/>

            <TableColumn fx:id="endTimeColumn"
                         text="End Time"
                         prefWidth="110"/>

            <TableColumn fx:id="roomColumn"
                         text="Room"
                         prefWidth="120"/>

        </columns>

    </TableView>

    <Button text="Refresh Schedule"
            onAction="#loadSchedule"/>

</VBox>