<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.AssignClassSemesterController"
            prefWidth="700"
            prefHeight="600"
            stylesheets="@../styles/assign_class_semester.css"
            styleClass="assign-root">

    <VBox spacing="20"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <padding>
            <Insets top="30"
                    right="36"
                    bottom="30"
                    left="36"/>
        </padding>


        <!-- Header -->
        <VBox alignment="CENTER"
              spacing="5">

            <Label text="Assign Module &amp; Class"
                   styleClass="page-title"/>

            <Label fx:id="lecturerNameLabel"
                   text="Assign to: Lecturer"
                   styleClass="lecturer-pill"/>

        </VBox>


        <!-- Class / Semester Selection -->
        <HBox spacing="16"
              alignment="BOTTOM_LEFT"
              styleClass="selector-card">

            <!-- Class -->
            <VBox spacing="5">

                <Label text="Class"
                       styleClass="field-caption"/>

                <ComboBox fx:id="classComboBox"
                          prefWidth="210"
                          promptText="Select Class"
                          styleClass="dropdown"/>

            </VBox>


            <!-- Semester -->
            <VBox spacing="5">

                <Label text="Semester"
                       styleClass="field-caption"/>

                <ComboBox fx:id="semesterComboBox"
                          prefWidth="180"
                          promptText="Select Semester"
                          styleClass="dropdown"/>

            </VBox>


            <!-- Load Modules -->
            <Button text="🔄  Load Modules"
                    onAction="#handleLoadModules"
                    styleClass="btn-load"/>

        </HBox>


        <!-- Available Modules -->
        <VBox spacing="10"
              VBox.vgrow="ALWAYS">

            <Label text="Available Modules"
                   styleClass="section-title"/>

            <VBox spacing="0"
                  styleClass="list-card"
                  VBox.vgrow="ALWAYS">

                <ListView fx:id="moduleListView"
                          VBox.vgrow="ALWAYS"
                          styleClass="module-list"/>

            </VBox>

        </VBox>


        <!-- Assign -->
        <Button text="✔  Assign Selected Modules"
                onAction="#handleAssignModules"
                maxWidth="Infinity"
                styleClass="btn-assign"/>

    </VBox>

</AnchorPane>

