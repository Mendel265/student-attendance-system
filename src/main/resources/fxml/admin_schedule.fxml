<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.studentattendance.AdminScheduleController"
      prefWidth="700"
      prefHeight="600"
      stylesheets="@../styles/assign_class_semester.css"
      styleClass="assign-root"
      spacing="20"
     >

    <padding>
        <Insets top="30"
                right="36"
                bottom="30"
                left="36"/>
    </padding>

    <!-- Header -->
    <VBox spacing="4">

        <HBox alignment="CENTER_LEFT"
              spacing="15">

            <Button onAction="#handleBack"
                    styleClass="btn-back">

                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left"
                              styleClass="back-icon"/>
                </graphic>

                <text>Back</text>
            </Button>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER"
                  spacing="10">

                <FontIcon iconLiteral="fas-calendar-alt"
                          styleClass="header-icon"/>

                <Label text="Lecture Schedule"
                       styleClass="page-title"/>

            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

        </HBox>

        <Label text="Plan and manage the lecture timetable"
               styleClass="page-subtitle"
               alignment="CENTER"
               maxWidth="Infinity"/>

    </VBox>

    <!-- Schedule Form -->
    <VBox spacing="15"
          styleClass="form-card">

        <Label text="Create Lecture Schedule"
               styleClass="section-title"/>

        <!-- Lecturer / Module / Class -->
        <HBox spacing="15">

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="Lecturer"
                       styleClass="field-caption"/>

                <ComboBox fx:id="lecturerComboBox"
                          promptText="Select Lecturer"
                          maxWidth="Infinity"
                          styleClass="dropdown"/>

            </VBox>

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="Module"
                       styleClass="field-caption"/>

                <ComboBox fx:id="moduleComboBox"
                          promptText="Select Module"
                          maxWidth="Infinity"
                          styleClass="dropdown"/>

            </VBox>

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="Class"
                       styleClass="field-caption"/>

                <ComboBox fx:id="classComboBox"
                          promptText="Select Class"
                          maxWidth="Infinity"
                          styleClass="dropdown"/>

            </VBox>

        </HBox>

        <!-- Day / Time -->
        <HBox spacing="15">

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="Day"
                       styleClass="field-caption"/>

                <ComboBox fx:id="dayComboBox"
                          promptText="Select Day"
                          maxWidth="Infinity"
                          styleClass="dropdown"/>

            </VBox>

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="Start Time"
                       styleClass="field-caption"/>

                <TextField fx:id="startTimeField"
                           promptText="e.g. 08:00"
                           styleClass="text-input"/>

            </VBox>

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="End Time"
                       styleClass="field-caption"/>

                <TextField fx:id="endTimeField"
                           promptText="e.g. 10:00"
                           styleClass="text-input"/>

            </VBox>

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="Room"
                       styleClass="field-caption"/>

                <TextField fx:id="roomField"
                           promptText="e.g. Room 1"
                           styleClass="text-input"/>

            </VBox>

        </HBox>

        <HBox alignment="CENTER_RIGHT"
              spacing="12">

            <Button text="Clear"
                    onAction="#handleClear"
                    styleClass="btn-secondary"/>

            <Button text="Add Schedule"
                    onAction="#handleAddSchedule"
                    styleClass="btn-primary"/>

        </HBox>

    </VBox>

    <!-- Schedule Table -->
    <VBox spacing="10"
          styleClass="list-card"
          VBox.vgrow="ALWAYS">

        <Label text="Current Lecture Timetable"
               styleClass="section-title"/>

        <TableView fx:id="scheduleTable"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="lecturerColumn"
                             text="Lecturer"
                             prefWidth="170"/>

                <TableColumn fx:id="moduleColumn"
                             text="Module"
                             prefWidth="180"/>

                <TableColumn fx:id="classColumn"
                             text="Class"
                             prefWidth="110"/>

                <TableColumn fx:id="dayColumn"
                             text="Day"
                             prefWidth="100"/>

                <TableColumn fx:id="startTimeColumn"
                             text="Start Time"
                             prefWidth="100"/>

                <TableColumn fx:id="endTimeColumn"
                             text="End Time"
                             prefWidth="100"/>

                <TableColumn fx:id="roomColumn"
                             text="Room"
                             prefWidth="100"/>

            </columns>

        </TableView>

        <HBox alignment="CENTER_RIGHT"
              spacing="12">

            <Button text="Edit Schedule"
                    onAction="#handleEditSchedule"
                    styleClass="btn-primary"/>

            <Button text="Delete Schedule"
                    onAction="#handleDeleteSchedule"
                    styleClass="btn-danger"/>

        </HBox>

    </VBox>

</VBox>