<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.studentattendance.ManageScheduleController"
      spacing="20">

    <padding>
        <Insets top="25"
                right="30"
                bottom="25"
                left="30"/>
    </padding>

    <!-- Header -->
    <VBox spacing="5">

        <Label text="Manage Lecture Schedule">
            <font>
                <Font size="26"/>
            </font>
        </Label>

        <Label text="Create and manage the university lecture timetable."/>
    </VBox>


    <!-- Schedule Form -->
    <GridPane hgap="15"
              vgap="12">

        <columnConstraints>
            <ColumnConstraints prefWidth="130"/>
            <ColumnConstraints prefWidth="220"/>
            <ColumnConstraints prefWidth="130"/>
            <ColumnConstraints prefWidth="220"/>
        </columnConstraints>


        <!-- Lecturer -->
        <Label text="Lecturer:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="lecturerComboBox"
                  promptText="Select Lecturer"
                  prefWidth="220"
                  GridPane.rowIndex="0"
                  GridPane.columnIndex="1"/>


        <!-- Module -->
        <Label text="Module:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="2"/>

        <ComboBox fx:id="moduleComboBox"
                  promptText="Select Module"
                  prefWidth="220"
                  GridPane.rowIndex="0"
                  GridPane.columnIndex="3"/>


        <!-- Class -->
        <Label text="Class:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="classComboBox"
                  promptText="Select Class"
                  prefWidth="220"
                  GridPane.rowIndex="1"
                  GridPane.columnIndex="1"/>


        <!-- Day -->
        <Label text="Day:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="2"/>

        <ComboBox fx:id="dayComboBox"
                  promptText="Select Day"
                  prefWidth="220"
                  GridPane.rowIndex="1"
                  GridPane.columnIndex="3"/>


        <!-- Start Time -->
        <Label text="Start Time:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="startTimeField"
                   promptText="08:00"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>


        <!-- End Time -->
        <Label text="End Time:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="2"/>

        <TextField fx:id="endTimeField"
                   promptText="10:00"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="3"/>


        <!-- Room -->
        <Label text="Room:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField fx:id="roomField"
                   promptText="e.g. Room 5"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

    </GridPane>


    <!-- Action Buttons -->
    <HBox spacing="10">

        <Button text="Add Schedule"
                onAction="#handleAddSchedule"/>

        <Button text="Update"
                onAction="#handleUpdateSchedule"/>

        <Button text="Delete"
                onAction="#handleDeleteSchedule"/>

        <Button text="Clear"
                onAction="#handleClear"/>

        <Button text="Refresh"
                onAction="#loadSchedule"/>

    </HBox>


    <!-- Schedule Table -->
    <TableView fx:id="scheduleTable"
               prefHeight="450"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="lecturerColumn"
                         text="Lecturer"
                         prefWidth="170"/>

            <TableColumn fx:id="moduleColumn"
                         text="Module"
                         prefWidth="180"/>

            <TableColumn fx:id="classColumn"
                         text="Class"
                         prefWidth="170"/>

            <TableColumn fx:id="dayColumn"
                         text="Day"
                         prefWidth="110"/>

            <TableColumn fx:id="startTimeColumn"
                         text="Start Time"
                         prefWidth="100"/>

            <TableColumn fx:id="endTimeColumn"
                         text="End Time"
                         prefWidth="100"/>

            <TableColumn fx:id="roomColumn"
                         text="Room"
                         prefWidth="120"/>

        </columns>

    </TableView>

</VBox>