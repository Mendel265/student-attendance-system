<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<BorderPane prefHeight="640" prefWidth="1020"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.AdminDashboardController"
            stylesheets="@../styles/admin_dashboard.css"
            styleClass="admin-root">

    <!-- Left: Sidebar navigation -->
    <left>
        <VBox styleClass="sidebar" spacing="4" prefWidth="240">

            <VBox styleClass="sidebar-brand" spacing="2">
                <padding>
                    <Insets top="28" right="24" bottom="24" left="24"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="fas-graduation-cap" styleClass="brand-icon"/>
                    <Label text="Attendance" styleClass="brand-title"/>
                </HBox>
                <Label text="Admin Console" styleClass="brand-subtitle"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="4" styleClass="sidebar-nav">
                <padding>
                    <Insets top="16" right="12" bottom="12" left="12"/>
                </padding>

                <Button onAction="#handleManageLecturers" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-chalkboard-teacher" styleClass="sidebar-icon"/>
                    </graphic>
                    <text>Lecturers</text>
                </Button>

                <Button onAction="#handleManageStudents" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-user-graduate" styleClass="sidebar-icon"/>
                    </graphic>
                    <text>Students</text>
                </Button>

                <Button onAction="#handleManageClasses" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-school" styleClass="sidebar-icon"/>
                    </graphic>
                    <text>Classes</text>
                </Button>

                <Button onAction="#handleViewReports" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-chart-bar" styleClass="sidebar-icon"/>
                    </graphic>
                    <text>Attendance Reports</text>
                </Button>

                <Button onAction="#handleManageSchedule" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-calendar-alt" styleClass="sidebar-icon"/>
                    </graphic>
                    <text>Lecture Schedule</text>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-footer">
                <padding>
                    <Insets top="12" right="12" bottom="20" left="12"/>
                </padding>
                <Button onAction="#handleLogout" styleClass="btn-logout" maxWidth="Infinity">
                    <graphic>
                        <FontIcon iconLiteral="fas-sign-out-alt" styleClass="logout-icon"/>
                    </graphic>
                    <text>Logout</text>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- Top: Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="topbar">
            <padding>
                <Insets top="24" right="36" bottom="24" left="36"/>
            </padding>

            <VBox spacing="4">
                <Label text="Welcome back, Admin" styleClass="page-title"/>
                <Label text="Here's what's happening across your institution today" styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- Center: Dashboard content -->
    <center>
        <VBox spacing="24" styleClass="content-area">
            <padding>
                <Insets top="8" right="36" bottom="36" left="36"/>
            </padding>

            <!-- ================================================= -->
            <!-- STATISTICS -->
            <!-- ================================================= -->

            <HBox spacing="18" styleClass="stat-strip">

                <!-- Lecturers -->
                <VBox styleClass="stat-card"
                      HBox.hgrow="ALWAYS"
                      maxWidth="Infinity">

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fas-users"
                                  styleClass="stat-icon"/>

                        <Label text="LECTURERS"
                               styleClass="stat-label"/>
                    </HBox>

                    <Label fx:id="lecturerCountLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>


                <!-- Students -->
                <VBox styleClass="stat-card"
                      HBox.hgrow="ALWAYS"
                      maxWidth="Infinity">

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fas-user-friends"
                                  styleClass="stat-icon"/>

                        <Label text="STUDENTS"
                               styleClass="stat-label"/>
                    </HBox>

                    <Label fx:id="studentCountLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>


                <!-- Classes -->
                <VBox styleClass="stat-card"
                      HBox.hgrow="ALWAYS"
                      maxWidth="Infinity">

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fas-chalkboard"
                                  styleClass="stat-icon"/>

                        <Label text="CLASSES"
                               styleClass="stat-label"/>
                    </HBox>

                    <Label fx:id="classCountLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>


                <!-- Present Today -->
                <VBox styleClass="stat-card"
                      HBox.hgrow="ALWAYS"
                      maxWidth="Infinity">

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fas-calendar-check"
                                  styleClass="stat-icon"/>

                        <Label text="PRESENT TODAY"
                               styleClass="stat-label"/>
                    </HBox>

                    <Label fx:id="attendanceCountLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

            </HBox>


            <!-- ================================================= -->
            <!-- TODAY'S LECTURES -->
            <!-- ================================================= -->

            <VBox spacing="12"
                  styleClass="dashboard-section"
                  VBox.vgrow="ALWAYS">

                <!-- Section Header -->
                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label text="Today's Lectures"
                               styleClass="section-heading"/>

                        <Label fx:id="lectureDateLabel"
                               text="Today's scheduled lectures"
                               styleClass="section-subtitle"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <FontIcon iconLiteral="fas-calendar-day"
                              styleClass="section-icon"/>

                </HBox>


                <!-- Lecture Table -->
                <TableView fx:id="todayLecturesTable"
                           styleClass="dashboard-table"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <!-- Time -->
                        <TableColumn fx:id="timeColumn"
                                     text="TIME"
                                     prefWidth="130"
                                     minWidth="100"/>

                        <!-- Module -->
                        <TableColumn fx:id="moduleColumn"
                                     text="MODULE"
                                     prefWidth="190"
                                     minWidth="150"/>

                        <!-- Lecturer -->
                        <TableColumn fx:id="lecturerColumn"
                                     text="LECTURER"
                                     prefWidth="190"
                                     minWidth="150"/>

                        <!-- Room -->
                        <TableColumn fx:id="roomColumn"
                                     text="ROOM"
                                     prefWidth="120"
                                     minWidth="90"/>

                        <!-- Class -->
                        <TableColumn fx:id="classColumn"
                                     text="CLASS"
                                     prefWidth="140"
                                     minWidth="100"/>

                    </columns>

                    <placeholder>
                        <VBox alignment="CENTER"
                              spacing="8">

                            <FontIcon iconLiteral="fas-calendar-times"
                                      styleClass="empty-icon"/>

                            <Label text="No lectures scheduled for today"
                                   styleClass="empty-message"/>

                        </VBox>
                    </placeholder>

                </TableView>

            </VBox>


            <!-- ================================================= -->
            <!-- TODAY'S ATTENDANCE -->
            <!-- ================================================= -->

            <VBox spacing="14"
                  styleClass="attendance-section">

                <!-- Header -->
                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label text="Today's Attendance"
                               styleClass="section-heading"/>

                        <Label text="Attendance activity recorded today"
                               styleClass="section-subtitle"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <FontIcon iconLiteral="fas-chart-pie"
                              styleClass="section-icon"/>

                </HBox>


                <!-- Attendance Summary -->
                <HBox spacing="16"
                      styleClass="attendance-summary">


                    <!-- Present -->
                    <VBox styleClass="attendance-card"
                          HBox.hgrow="ALWAYS"
                          maxWidth="Infinity">

                        <HBox alignment="CENTER_LEFT"
                              spacing="10">

                            <FontIcon iconLiteral="fas-check-circle"
                                      styleClass="attendance-present-icon"/>

                            <VBox spacing="2">

                                <Label text="PRESENT"
                                       styleClass="attendance-label"/>

                                <Label fx:id="presentAttendanceLabel"
                                       text="0"
                                       styleClass="attendance-value"/>

                            </VBox>

                        </HBox>

                    </VBox>


                    <!-- Absent -->
                    <VBox styleClass="attendance-card"
                          HBox.hgrow="ALWAYS"
                          maxWidth="Infinity">

                        <HBox alignment="CENTER_LEFT"
                              spacing="10">

                            <FontIcon iconLiteral="fas-times-circle"
                                      styleClass="attendance-absent-icon"/>

                            <VBox spacing="2">

                                <Label text="ABSENT"
                                       styleClass="attendance-label"/>

                                <Label fx:id="absentAttendanceLabel"
                                       text="0"
                                       styleClass="attendance-value"/>

                            </VBox>

                        </HBox>

                    </VBox>


                    <!-- Pending -->
                    <VBox styleClass="attendance-card"
                          HBox.hgrow="ALWAYS"
                          maxWidth="Infinity">

                        <HBox alignment="CENTER_LEFT"
                              spacing="10">

                            <FontIcon iconLiteral="fas-clock"
                                      styleClass="attendance-pending-icon"/>

                            <VBox spacing="2">

                                <Label text="PENDING"
                                       styleClass="attendance-label"/>

                                <Label fx:id="pendingAttendanceLabel"
                                       text="0"
                                       styleClass="attendance-value"/>

                            </VBox>

                        </HBox>

                    </VBox>


                    <!-- Total -->
                    <VBox styleClass="attendance-card"
                          HBox.hgrow="ALWAYS"
                          maxWidth="Infinity">

                        <HBox alignment="CENTER_LEFT"
                              spacing="10">

                            <FontIcon iconLiteral="fas-clipboard-list"
                                      styleClass="attendance-total-icon"/>

                            <VBox spacing="2">

                                <Label text="TOTAL RECORDS"
                                       styleClass="attendance-label"/>

                                <Label fx:id="totalAttendanceLabel"
                                       text="0"
                                       styleClass="attendance-value"/>

                            </VBox>

                        </HBox>

                    </VBox>

                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>