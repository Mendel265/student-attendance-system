<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.ManageLecturerController"
            stylesheets="@../styles/admin_dashboard.css">

    <VBox spacing="20"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <padding>
            <Insets top="30"
                    right="36"
                    bottom="30"
                    left="36"/>
        </padding>

        <!-- Header with Back Button -->
        <VBox spacing="4">

            <!-- Top row: Back button + Title -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <!-- Back Button -->
                <Button onAction="#handleBack" styleClass="btn-back">
                    <graphic>
                        <FontIcon iconLiteral="fas-arrow-left" styleClass="back-icon"/>
                    </graphic>
                    <text>Back</text>
                </Button>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Title with Icon -->
                <HBox alignment="CENTER" spacing="10">
                    <FontIcon iconLiteral="fas-chalkboard-teacher" styleClass="header-icon"/>
                    <Label text="Manage Lecturers" styleClass="page-title"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Subtitle -->
            <Label text="View and manage all registered lecturers"
                   styleClass="page-subtitle"
                   alignment="CENTER"
                   maxWidth="Infinity"/>

        </VBox>

        <!-- Lecturer Table -->
        <VBox spacing="10"
              styleClass="list-card"
              VBox.vgrow="ALWAYS">

            <TableView fx:id="lecturerTable">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="80"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Name"
                                 prefWidth="180"/>

                    <TableColumn fx:id="emailColumn"
                                 text="Email"
                                 prefWidth="220"/>

                </columns>

            </TableView>

            <!-- Buttons -->
            <HBox alignment="CENTER_RIGHT"
                  spacing="15">

                <!-- Add Lecturer -->
                <Button onAction="#handleAddLecturer"
                        styleClass="btn-primary">

                    <graphic>
                        <FontIcon iconLiteral="fas-plus-circle"
                                  styleClass="btn-icon"/>
                    </graphic>

                    <text>Add Lecturer</text>
                </Button>


                <!-- Assign Class & Modules -->
                <Button onAction="#handleAssignToClass"
                        styleClass="btn-secondary">

                    <graphic>
                        <FontIcon iconLiteral="fas-chalkboard-teacher"
                                  styleClass="btn-icon"/>
                    </graphic>

                    <text>Assign Class &amp; Modules</text>
                </Button>


                <!-- Edit Lecturer -->
                <Button onAction="#handleEditLecturer"
                        styleClass="btn-primary">

                    <graphic>
                        <FontIcon iconLiteral="fas-edit"
                                  styleClass="btn-icon"/>
                    </graphic>

                    <text>Edit Lecturer</text>
                </Button>


                <!-- Delete Lecturer -->
                <Button onAction="#handleDeleteLecturer"
                        styleClass="btn-danger">

                    <graphic>
                        <FontIcon iconLiteral="fas-trash-alt"
                                  styleClass="btn-icon"/>
                    </graphic>

                    <text>Delete</text>
                </Button>

            </HBox>

        </VBox>

    </VBox>

</AnchorPane>