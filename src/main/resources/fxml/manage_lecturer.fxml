<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.studentattendance.ManageLecturerController">


    <VBox spacing="20"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <padding>
            <Insets top="30"
                    right="36"
                    bottom="30"
                    left="36"/>
        </padding>


        <!-- Header -->
        <VBox alignment="CENTER"
              spacing="4">

            <Label text="Manage Lecturers"
                   styleClass="page-title"/>

            <Label text="View and manage all registered lecturers"
                   styleClass="page-subtitle"/>

        </VBox>



        <!-- Lecturer Table -->
        <VBox spacing="10"
              styleClass="list-card"
              VBox.vgrow="ALWAYS">


            <TableView fx:id="lecturerTable">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="80"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Name"
                                 prefWidth="180"/>

                    <TableColumn fx:id="emailColumn"
                                 text="Email"
                                 prefWidth="220"/>

                </columns>

            </TableView>



            <!-- Buttons -->
            <HBox alignment="CENTER_RIGHT"
                  spacing="15">


                <Button text="➕ Add Lecturer"
                        onAction="#handleAddLecturer"
                        styleClass="btn-primary"/>


                <Button text="Assign Module"
                        onAction="#handleAssignModules"/>


                <Button text="✏ Edit Lecturer"
                        onAction="#handleEditLecturer"
                        styleClass="btn-primary"/>


                <Button text="🗑 Delete"
                        onAction="#handleDeleteLecturer"
                        styleClass="btn-danger"/>


            </HBox>


        </VBox>


    </VBox>


</AnchorPane>